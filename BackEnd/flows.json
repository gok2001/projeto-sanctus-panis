        "name": "selectAllLanche",
        "func": "msg.topic = `\n    SELECT\n        lanche.idLanche,\n        lanche.nomeLanche,\n        lanche.precoLanche,\n\n        GROUP_CONCAT(\n            produto.nomeProduto\n            SEPARATOR ', '\n        ) AS descricao\n    FROM lanche\n    \n    JOIN ingredienteLanche\n        ON lanche.idLanche = ingredienteLanche.idLanche\n\n    JOIN produto\n        ON produto.idProduto = ingredienteLanche.idProduto\n\n    GROUP BY lanche.idLanche\n`;\nreturn msg;",
