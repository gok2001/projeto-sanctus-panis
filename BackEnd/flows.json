    {
        "id": "76480be9ee9aedcb",
        "type": "function",
        "z": "e7e6ac57badb8044",
        "name": "selectAllLanche",
        "func": "msg.topic = `\n    SELECT\n        lanche.idLanche,\n        lanche.nomeLanche,\n        lanche.precoLanche,\n\n        GROUP_CONCAT(\n            produto.nomeProduto\n            SEPARATOR ', '\n        ) AS descricao\n    FROM lanche\n    \n    JOIN ingredienteLanche\n        ON lanche.idLanche =\n           ingredienteLanche.idLanche\n\n    JOIN produto\n        ON produto.idProduto =\n           ingredienteLanche.idProduto\n\n    GROUP BY lanche.idLanche\n`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
