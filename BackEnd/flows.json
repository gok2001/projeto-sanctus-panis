        "name": "selectItensPedido",
        "func": "let idPedido = msg.req.params.idPedido;\n\nmsg.topic = `\n    SELECT\n        l.nomeLanche,\n        l.precoLanche,\n        i.quantidade\n    FROM itemPedido i\n    INNER JOIN lanche l\n        ON i.idLanche = l.idLanche\n        \n    WHERE i.idPedido = ?\n`;\n\nmsg.payload = [idPedido];\n\nreturn msg;\n",
