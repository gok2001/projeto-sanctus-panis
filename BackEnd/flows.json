    {
        "id": "d8e195b00e7e7faf",
        "type": "function",
        "z": "7da178446d48c9d6",
        "name": "removerEstoque",
        "func": "let idPedido = msg.payload.idPedido;\n\nmsg.topic = `\n    UPDATE produto p\n    JOIN (\n        SELECT\n            il.idProduto,\n            SUM(ip.quantidade * il.quantidade) AS quantidadeConsumida\n        FROM itemPedido ip\n        JOIN ingredienteLanche il\n            ON ip.idLanche = il.idLanche\n        WHERE ip.idPedido = ?\n        GROUP BY il.idProduto\n    ) consumo\n    ON p.idProduto = consumo.idProduto\n    SET p.qtdProduto = p.qtdProduto - consumo.quantidadeConsumida\n`;\n\nmsg.payload = [idPedido];\n\nreturn msg;",
